# web-translator 환경 변수 예시
# 본 파일은 자리표시자. 실제 값은 `.env`로 복사 후 채워서 사용.
# `.env` 및 `.env.local`은 `.gitignore`에 포함되어 커밋 차단.
#
# v1 시점에서는 런타임/빌드 모두 환경 변수 미사용 (순수 정적 클라이언트 사이드).
# 향후 도입 예정 항목 자리표시자만 아래에 기재.

# ---- 빌드/배포 (선택) ----
# 빌드 산출물 버전 라벨 (esbuild --define 등에 주입 가능)
# WT_VERSION=1.0.0

# ---- 폴백 엔진 (v2 후속) ----
# MyMemory 익명 호출 시 일일 한도 상향용 이메일
# MYMEMORY_EMAIL=

# LibreTranslate 자체 호스팅 엔드포인트 URL
# LIBRETRANSLATE_URL=

# ---- 유료 엔진 (선택) ----
# DeepL API 키. CDN 전용 배포에서는 사용 비권장 (키 노출 위험).
# 별도 프록시 서버 또는 Cloudflare Workers 경유 시에만 활용.
# DEEPL_API_KEY=
